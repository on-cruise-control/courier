<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" style="margin:0; padding:0;">
  <head>
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <title></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style type="text/css">
      img { max-width: 100%; }
      body {
        -webkit-font-smoothing: antialiased;
        -webkit-text-size-adjust: none;
        width: 100% !important;
        height: 100%;
        margin: 0;
        padding: 0;
        background-color: #f0f4f8;
        font-family: 'Outfit', 'Inter', -apple-system, system-ui, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Tahoma, Arial, sans-serif;
        font-size: 14px;
        line-height: 1.6em;
      }
      @media only screen and (max-width: 640px) {
        .container { width: 100% !important; padding: 0 !important; }
        .content-wrap { padding: 20px 16px !important; }
        .header-cell { padding: 14px 16px !important; }
      }
    </style>
  </head>

  <body bgcolor="#f0f4f8" style="margin:0; padding:0; background-color:#f0f4f8;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f0f4f8" style="background-color:#f0f4f8; margin:0; padding:0;">
      <tr>
        <td align="center" valign="top" style="padding:32px 12px;">

          <table class="container" width="560" cellpadding="0" cellspacing="0" border="0" style="max-width:560px; width:100%;">

            <!-- Header -->
            <tr>
              <td class="header-cell" style="background-color:#182933; border-radius:8px 8px 0 0; padding:16px 20px;">
                <table cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td style="vertical-align:middle; padding-right:10px;">
                      <img src="{{ global_config['FRONTEND_URL'] }}/favicon-96x96.png"
                           alt="{{ global_config['BRAND_NAME'] }}" width="34" height="34"
                           style="display:block; border:0; border-radius:50%;" />
                    </td>
                    <td style="vertical-align:middle;">
                      <span style="color:#ffffff; font-size:15px; font-weight:700; letter-spacing:0.5px; text-transform:uppercase;">
                        {{ global_config['BRAND_NAME'] }}
                      </span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Content card -->
            <tr>
              <td class="content-wrap" style="background-color:#ffffff; font-family:'Outfit','Inter',-apple-system,system-ui,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Tahoma,Arial,sans-serif; font-size:14px; padding:20px; color:#111827;" valign="top">
                <table width="100%" cellpadding="0" cellspacing="0" style="margin:0;">
                  {{ content_for_layout }}
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="background-color:#182933; border-radius:0 0 8px 8px; padding:13px 24px;" align="center">
                <p style="margin:0 0 6px; font-size:13px; color:#94a3b8;">
                  Powered by
                  <a href="{{ global_config['BRAND_URL'] }}" style="color:#ffffff; font-weight:600; text-decoration:none;">
                    {{ global_config['BRAND_NAME'] }}
                  </a>
                </p>
                <p style="margin:0; font-size:11px; color:#64748b;">
                  &copy; 2026 {{ global_config['BRAND_NAME'] }}. All rights reserved.
                </p>
              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>
  </body>
</html>
