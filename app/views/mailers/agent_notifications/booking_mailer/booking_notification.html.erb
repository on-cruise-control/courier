
<div style="max-width: 600px; background: #fff; border-radius: 16px; box-shadow: 0 4px 24px rgba(0,0,0,0.08); padding: 4px 24px; font-family:'Outfit','Inter',-apple-system,system-ui,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Tahoma,Arial,sans-serif;">
  <p style="font-size: 18px; margin-bottom: 16px;">Hey,</p>

  <p style="font-size: 16px; margin-bottom: 24px;">A new booking was scheduled with the following details:</p>

  <table style="border-collapse: separate; border-spacing: 0; width: 100%; margin-bottom: 28px; font-size: 15px;">
    <% 
      rows = [
        { label: 'Dealership Name', value: @account&.name },
        { label: 'Name', value: @conversation&.contact&.name },
        { label: 'Date', value: @booking_date },
        { label: 'Platform', value: "#{@platform_name} (DM)" },
        { label: 'Type', value: 'Sales & general inquiry' },
        { label: 'Phone', value: @phone },
        { label: 'Email', value: @customer_email },
        { label: 'WhatsApp Number', value: @whatsapp_number },
        { label: 'SMS Number', value: @text_number }
      ]
      
      profile_url = @instagram_profile_url.presence
      if profile_url.present?
        label = @instagram_profile_url.present? ? 'Instagram Profile' : 'Facebook Profile'
        rows << { label: label, value: profile_url, is_link: true }
      end

      # Filter out empty or (N/A) values
      active_rows = rows.select { |row| row[:value].present? && row[:value] != '(N/A)' }
    %>

    <% active_rows.each_with_index do |row, index| %>
      <% is_even = index.even? %>
      <tr style="<%= is_even ? 'background: #f2f3f7;' : '' %>">
        <td style="font-weight: bold; padding: 10px 12px; <%= 'border-radius: 8px 0 0 0;' if index == 0 %> <%= 'border-radius: 0 0 0 8px;' if index == active_rows.size - 1 %>">
          <%= row[:label] %>
        </td>
        <td style="padding: 10px 12px; <%= 'border-radius: 0 8px 0 0;' if index == 0 %> <%= 'border-radius: 0 0 8px 0;' if index == active_rows.size - 1 %>">
          <% if row[:is_link] %>
            <a href="<%= row[:value] %>" target="_blank" rel="noopener" style="color:#1f93ff; text-decoration:none;">
              <%= row[:value] %>
            </a>
          <% else %>
            <%= row[:value] %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </table>
  
  <div style="margin-bottom: 24px;">
    <% if @conversation.summary.present? %>
      <p style="font-size: 16px; margin-bottom: 12px;"><strong>Conversation Summary</strong></p>
      <div style="background-color: #f3f4f6; color: #000000; border-radius: 8px; padding: 16px; font-size: 14px; line-height: 1.6;">
        <%= simple_format(@conversation.summary) %>
      </div>
    <% end %>
  </div>

  <p style="margin-top: 32px; font-size: 15px; color: #555;">Best,<br><span style="font-weight: bold; color: #182933;">Team Cruise Control</span></p>
</div>
