<table width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:'Outfit','Inter',-apple-system,system-ui,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Tahoma,Arial,sans-serif;">

  <tr>
    <td style="padding:20px 0 20px;">
      <p style="margin:0; font-size:16px; color:#000000; line-height:1.6;">
        We would like to bring to your immediate attention a customer interaction that requires urgent escalation and follow-up.
      </p>
    </td>
  </tr>

  <tr>
    <td style="padding:0 0 20px;">
      <table width="100%" cellpadding="0" cellspacing="0" style="background:#f9fafb; border-radius:8px;">
        <% if @customer_name.present? && @customer_name != "(N/A)" %>
        <tr>
          <td style="padding:10px 14px; font-size:13px; color:#6b7280; width:100px;">Name</td>
          <td style="padding:10px 14px; font-size:14px; font-weight:600; color:#111827;"><%= @customer_name %></td>
        </tr>
        <% end %>
        <% if @customer_phone.present? && @customer_phone != "(N/A)" %>
        <tr>
          <td style="padding:10px 14px; font-size:13px; color:#6b7280; border-top:1px solid #e5e7eb;">Phone</td>
          <td style="padding:10px 14px; font-size:14px; font-weight:600; color:#111827; border-top:1px solid #e5e7eb;"><%= @customer_phone %></td>
        </tr>
        <% end %>
        <% if @customer_email.present? && @customer_email != "(N/A)" %>
        <tr>
          <td style="padding:10px 14px; font-size:13px; color:#6b7280; border-top:1px solid #e5e7eb;">Email</td>
          <td style="padding:10px 14px; font-size:14px; font-weight:600; color:#111827; border-top:1px solid #e5e7eb;"><%= @customer_email %></td>
        </tr>
        <% end %>
        <tr>
          <td style="padding:10px 14px; font-size:13px; color:#6b7280; border-top:1px solid #e5e7eb;">Platform</td>
          <td style="padding:10px 14px; font-size:14px; font-weight:600; color:#111827; border-top:1px solid #e5e7eb;"><%= @platform_name %></td>
        </tr>
      </table>
    </td>
  </tr>

  <% if @summary.present? %>
  <tr>
    <td style="padding:0 0 6px;">
      <p style="margin:0; font-size:14px; font-weight:700; color:#111827;">Conversation Summary</p>
    </td>
  </tr>
  <tr>
    <td style="padding:0 0 20px;">
      <div style="background-color:#f3f4f6; border-radius:6px; padding:14px 16px;">
        <%= simple_format(@summary, style: 'margin:0 0 10px 0; font-size:14px; color:#374151; line-height:1.6;', last_paragraph_style: 'margin:0; font-size:14px; color:#374151; line-height:1.6;') %>
      </div>
    </td>
  </tr>
  <% end %>

  <tr>
    <td style="padding:0 0 12px;">
      <p style="margin:0; font-size:15px; color:#000000; line-height:1.6;">
        We recommend treating this as a high-priority recovery opportunity to improve the customer experience and reinforce brand trust.
      </p>
    </td>
  </tr>

  <tr>
    <td style="padding:0 0 20px;">
      <p style="margin:0; font-size:15px; color:#000000; line-height:1.6;">
        Please confirm once the outreach has been completed.
      </p>
    </td>
  </tr>

  <tr>
    <td style="padding:4px 10px 28px;">
      <table width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="vertical-align:middle;">
            <a href="<%= @action_url %>"
               style="display:inline-block; padding:12px 25px; background-color:#182933; color:#ffffff; font-size:14px; font-weight:500; text-decoration:none; border-radius:6px;">
              View Conversation
            </a>
          </td>
          <td align="right" style="vertical-align:middle;">
            <span style="background:#fee2e2; color:#cd1c1c; font-size:13px; font-weight:700; padding:5px 12px; border-radius:30px; border:1px solid #fca5a5; text-transform:uppercase;">
              Urgent Escalation
            </span>
          </td>
        </tr>
      </table>
    </td>
  </tr>

</table>
