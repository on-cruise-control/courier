<%
  brand_name = global_config['BRAND_NAME'] || 'Cruise Control'
  recipient_name = @user.name.presence || @user.email

  eyebrow = 'Reminder'
  heading = @stage == 'second' ? "Your #{brand_name} account is still waiting" : 'Complete your account setup'
  intro_text = if @account_name.present?
    "You were invited to join the #{@account_name} workspace on #{brand_name}, but haven't finished setting up your account yet."
  else
    "You started creating your #{brand_name} account, but haven't finished setting it up yet."
  end
  supporting_text = "Once you're set up, you can also log in from your mobile device, making it easy to stay on top of new sales bookings and escalations on the go."
  action_text = 'Activate your account'
  action_url = frontend_url('auth/password/edit', reset_password_token: @reset_password_token)
%>

<%= render partial: 'devise/mailer/confirmation_body', locals: {
  action_text: action_text,
  action_url: action_url,
  detail_rows: [],
  eyebrow: eyebrow,
  heading: heading,
  info_text: nil,
  info_title: nil,
  intro_text: intro_text,
  recipient_name: recipient_name,
  supporting_text: supporting_text
} %>
