<tr>
  <td style="font-family: -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
    <p>Hello {{ account.name }}, Team</p>

    <p style="margin-bottom: 20px;">
      We identified a conversation that needs to be escalated to a human with urgency. Please take over this conversation manually below.
    </p>

    <table cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-bottom: 20px;">
      {% if stark_customer_name %}
      <tr>
        <td style="padding: 5px 0;"><strong>Name:</strong> {{ stark_customer_name }}</td>
      </tr>
      {% endif %}
      <tr>
        <td style="padding: 5px 0;"><strong>Number:</strong> {{ stark_customer_phone }}</td>
      </tr>
      <tr>
        <td style="padding: 5px 0;"><strong>Email:</strong> {{ stark_customer_email }}</td>
      </tr>
      <tr>
        <td style="padding: 5px 0;"><strong>Platform:</strong> {{ inbox.platform_name }}</td>
      </tr>
      {% assign profile_url = instagram_profile_url %}
      {% if profile_url %}
        <tr>
          <td style="padding: 5px 0;">
            <strong>{% if instagram_profile_url %}Instagram Profile{% else %}Facebook Profile{% endif %}:</strong>
            <a href="{{ profile_url }}" target="_blank" rel="noopener" style="color:#1f93ff; text-decoration:none;">
              {{ profile_url }}
            </a>
          </td>
        </tr>
      {% endif %}
    </table>

    {% if conversation.summary %}
      <p><strong>Conversation Summary</strong></p>
      <div style="background-color: #f3f4f6; padding: 15px; border-radius: 6px; margin-bottom: 20px; line-height: 1.5;">
        {{ conversation.summary | newline_to_br }}
      </div>
    {% endif %}

    <table cellpadding="0" cellspacing="0" border="0" style="margin-top: 20px;">
      <tr>
        <td>
          <a href="{{ action_url }}" style="display: inline-block; padding: 10px 16px; background-color: #1f93ff; color: #ffffff; text-decoration: none; border-radius: 4px; font-weight: bold;">
            Respond Now
          </a>
        </td>
      </tr>
    </table>
  </td>
</tr>