<div style="max-width:600px;background:#fff;border-radius:16px;box-shadow:0 4px 24px rgba(0,0,0,0.08);padding:32px 32px 24px;font-family:'Outfit','Inter',-apple-system,system-ui,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Tahoma,Arial,sans-serif;">

  <p style="font-size:18px;margin:0 0 8px;color:#111827;font-weight:500;">Hey,</p>
  <p style="font-size:15px;margin:0 0 24px;color:#6b7280;">
    A customer has submitted a contact request for a vehicle through the web widget.
  </p>

  <% if @vehicle_title.present? %>
    <div style="background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:12px 16px;margin-bottom:28px;">
      <p style="margin:0;font-size:15px;font-weight:700;color:#111827;">Vehicle: <%= @vehicle_title %></p>
    </div>
  <% end %>

  <%
    details = [
      { label: 'Name',  value: @name },
      { label: 'Phone', value: @phone },
      { label: 'Email', value: @email },
    ].select { |r| r[:value].present? }
  %>

  <table style="border-collapse:collapse;width:100%;margin-bottom:24px;font-size:15px;">
    <% details.each_with_index do |row, index| %>
      <tr style="border-bottom:1px solid #e5e7eb;">
        <td style="padding:13px 4px;width:28%;color:#6b7280;font-weight:500;vertical-align:top;">
          <%= row[:label] %>
        </td>
        <td style="padding:13px 4px;color:#111827;font-weight:500;vertical-align:top;">
          <%= row[:value] %>
        </td>
      </tr>
    <% end %>
  </table>

  <% if @message.present? %>
    <div style="margin-bottom:28px;">
      <p style="margin:0 0 8px;font-size:13px;font-weight:600;color:#6b7280;text-transform:uppercase;letter-spacing:0.05em;">Message</p>
      <div style="background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:16px 18px;">
        <p style="margin:0;font-size:15px;color:#111827;line-height:1.7;white-space:pre-wrap;"><%= @message %></p>
      </div>
    </div>
  <% end %>

  <div style="border-top:1px solid #e5e7eb;padding-top:20px;margin-top:4px;">
    <p style="margin:0;font-size:14px;color:#6b7280;">
      Best,<br>
      <span style="font-weight:700;color:#182933;">Team Cruise Control</span>
    </p>
  </div>

</div>
